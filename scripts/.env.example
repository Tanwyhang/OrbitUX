# RAILGUN Demo Environment Variables

# Ethereum Sepolia RPC URL (use any public Sepolia RPC)
SEPOLIA_RPC_URL=https://rpc.ankr.com/eth_sepolia

# Your wallet private key (for signing transactions)
# WARNING: Never commit this to version control
PRIVATE_KEY=your_private_key_here

# Your wallet mnemonic (for generating RAILGUN wallet)
# WARNING: Never commit this to version control
WALLET_MNEMONIC=your_wallet_mnemonic_phrase_here
